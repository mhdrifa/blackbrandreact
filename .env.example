# Mode: production | staging | mock
# - production: requires an explicitly configured VITE_PRODUCTION_API_URL
# - staging: connects strictly to VITE_STAGING_API_URL (separate test Code.gs + test Sheet)
# - mock: local dev/sandbox only (excluded from production builds)
VITE_APP_MODE=production

# Production Google Apps Script Web App /exec URL (never put secrets or Cashfree keys here)
VITE_PRODUCTION_API_URL=

# Separate Staging Google Apps Script Web App /exec URL (used only when VITE_APP_MODE=staging)
VITE_STAGING_API_URL=

# Supabase Preview admin authentication. Keep server secrets out of VITE_* variables.
VITE_USE_SUPABASE_PRODUCTS=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_SESSION_ENCRYPTION_KEY=
ADMIN_ALLOWED_ORIGIN=
